# ---------------------------------------------------------------------------
# OptiFlow · environment template
#
# Copy this file to `.env.local` and fill in the real values:
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored; this template is committed on purpose so the
# variable names never drift from the code.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required).
# Supabase: Project Settings > Database > Connection string. Use the pooler
# URI when the app runs on a serverless platform.
SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres

# Connection pool. Optional: the values below are the defaults applied by
# `src/lib/db.ts` when the variable is missing.
PG_POOL_MAX=10
PG_IDLE_MS=30000
PG_CONNECT_MS=10000

# Login throttling: attempts allowed per IP + username inside a 15-minute
# window. Optional, default 8 (`src/lib/auth.ts`).
OPTIFLOW_LOGIN_MAX=8

# Session lifetime in hours. Optional, default 12 (`src/lib/session.ts`).
OPTIFLOW_SESION_HORAS=12

# Initial administrator created by `npm run db:seed`.
#
# Leave OPTIFLOW_ADMIN_PASSWORD empty (or unset) and the seed generates a
# random password and prints it once. Set it to choose the password yourself.
# On an existing user, the password is only rotated when this variable has a
# value: running the seed again never breaks a working login.
OPTIFLOW_ADMIN_USER=admin
OPTIFLOW_ADMIN_NAME=Administrador
OPTIFLOW_ADMIN_PASSWORD=
